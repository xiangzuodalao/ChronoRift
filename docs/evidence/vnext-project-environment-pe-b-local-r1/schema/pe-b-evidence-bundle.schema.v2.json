{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronorift.invalid/evidence/project-environment-pe-b-bundle.v2.schema.json",
  "title": "ChronoRift Project Environment PE-B evidence bundle V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "evidenceProfile",
    "source",
    "toolchain",
    "adapter",
    "environment",
    "publication",
    "initializationAttempt",
    "first",
    "reuse",
    "limitations",
    "bundleContentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "evidenceKind": { "const": "chronorift-project-environment-pe-b-evidence" },
    "evidenceProfile": { "const": "dynamic-projection-two-session-v2" },
    "source": { "type": "object" },
    "toolchain": { "type": "object" },
    "adapter": { "type": "object" },
    "environment": { "type": "object" },
    "publication": { "type": "object" },
    "initializationAttempt": { "type": "object" },
    "first": { "$ref": "#/$defs/session" },
    "reuse": { "$ref": "#/$defs/session" },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "bundleContentHash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "session": {
      "type": "object",
      "required": [
        "schemaVersion",
        "taskId",
        "sessionId",
        "binding",
        "compatibility",
        "runtime",
        "turns",
        "capture",
        "goalDelivered"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "taskId": { "type": "string" },
        "sessionId": { "type": "string" },
        "binding": { "type": "object" },
        "compatibility": { "type": "object" },
        "runtime": { "type": "object" },
        "turns": { "type": "array", "minItems": 1 },
        "capture": { "type": "object" },
        "goalDelivered": { "const": true },
        "reuseReceipt": { "type": "object" }
      }
    }
  }
}
