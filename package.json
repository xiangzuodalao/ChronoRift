{
  "name": "chronorift",
  "version": "0.4.0",
  "description": "Secure, evidence-preserving Agent Runtime Harness for Godot, built on the Pi SDK.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiangzuodalao/ChronoRift.git"
  },
  "bugs": {
    "url": "https://github.com/xiangzuodalao/ChronoRift/issues"
  },
  "homepage": "https://github.com/xiangzuodalao/ChronoRift#readme",
  "keywords": [
    "ai-agents",
    "agent-infrastructure",
    "agent-harness",
    "godot",
    "sandbox",
    "evals",
    "typescript",
    "developer-tools"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:vnext:pi-live": "vitest run --config vitest.live.config.ts apps/cli/src/vnext/pi-session.live.test.ts",
    "test:godot": "vitest run --config vitest.godot.config.ts",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "test:vnext:godot-sandbox": "vitest run --config vitest.godot-sandbox.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "project": "tsx apps/cli/src/main.ts project",
    "task": "tsx apps/cli/src/main.ts task",
    "demo": "tsx apps/cli/src/main.ts demo",
    "demo:godot": "tsx apps/cli/src/main.ts demo --environment godot",
    "demo:platform-alias-ablation": "tsx apps/cli/src/main.ts demo-platform-alias-ablation",
    "demo:mob-orientation-ablation": "tsx apps/cli/src/main.ts demo-mob-orientation-ablation",
    "diagnose": "tsx apps/cli/src/main.ts diagnose",
    "demo:v04": "tsx apps/cli/src/main.ts demo-v04",
    "diagnose:v04": "tsx apps/cli/src/main.ts diagnose-v04",
    "fixtures": "tsx apps/cli/src/main.ts fixtures",
    "replay": "tsx apps/cli/src/main.ts replay",
    "models": "tsx apps/cli/src/main.ts models",
    "pi": "node packages/pi-harness/node_modules/@earendil-works/pi-coding-agent/dist/cli.js",
    "auth:volcengine": "tsx apps/cli/src/main.ts auth-volcengine",
    "pi:smoke": "tsx apps/cli/src/main.ts pi-smoke",
    "godot:doctor": "tsx apps/cli/src/main.ts godot-doctor",
    "godot:install": "tsx apps/cli/src/main.ts godot-install"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
