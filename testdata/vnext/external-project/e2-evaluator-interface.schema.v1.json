{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronorift.invalid/eval/e2-external-evaluator-interface.v1.schema.json",
  "title": "ChronoRift E2 External Evaluator Interface V1",
  "oneOf": [
    { "$ref": "#/$defs/taskSpec" },
    { "$ref": "#/$defs/productSubjectReceipt" },
    { "$ref": "#/$defs/cleanupReceipt" },
    { "$ref": "#/$defs/agentAttemptReceipt" },
    { "$ref": "#/$defs/invalidCandidateReceipt" },
    { "$ref": "#/$defs/evaluationRequest" },
    { "$ref": "#/$defs/evaluatedResult" },
    { "$ref": "#/$defs/infrastructureFailureResult" },
    { "$ref": "#/$defs/evaluationLedger" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "assignmentId": {
      "type": "string",
      "pattern": "^e2-assignment:[a-f0-9]{24}$"
    },
    "evaluationId": {
      "type": "string",
      "pattern": "^e2-evaluation:[a-f0-9]{24}$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^scenario:[a-f0-9]{24}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)(?:\\.|\\.\\.|\\.git)(?:/|$))[A-Za-z0-9._/-]{1,256}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "rawSha256"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "productInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "productSubjectReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptKind",
        "assignmentContentSha256",
        "assignmentId",
        "evaluationId",
        "repositoryCommit",
        "repositoryTree",
        "productInterfaces",
        "receiptContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receiptKind": { "const": "product_subject_checkout" },
        "assignmentContentSha256": { "$ref": "#/$defs/sha256" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "repositoryCommit": { "$ref": "#/$defs/gitCommit" },
        "repositoryTree": { "$ref": "#/$defs/gitCommit" },
        "productInterfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/productInterface" }
        },
        "receiptContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "taskScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "ordinal",
        "category",
        "sourceRole",
        "definition",
        "timeoutMs"
      ],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/scenarioId" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "category": { "enum": ["behavior", "regression"] },
        "sourceRole": { "enum": ["baseline", "candidate"] },
        "definition": { "$ref": "#/$defs/artifactReference" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 }
      }
    },
    "taskSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "specKind",
        "curatorTaskKeySha256",
        "productCommit",
        "baselineSourceSha256",
        "promptSha256",
        "scenarioPlanSha256",
        "scenarios"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "specKind": { "const": "chronorift-e2-holdout-task" },
        "curatorTaskKeySha256": { "$ref": "#/$defs/sha256" },
        "productCommit": { "$ref": "#/$defs/gitCommit" },
        "baselineSourceSha256": { "$ref": "#/$defs/sha256" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "scenarioPlanSha256": { "$ref": "#/$defs/sha256" },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "contains": {
            "type": "object",
            "required": ["sourceRole"],
            "properties": { "sourceRole": { "const": "candidate" } }
          },
          "minContains": 1,
          "items": { "$ref": "#/$defs/taskScenario" }
        }
      }
    },
    "agentUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "thinkingLevel",
        "attemptOrdinal",
        "turnCount",
        "hostMonotonicStartMs",
        "hostMonotonicEndMs",
        "totalToolCalls",
        "gameToolCalls",
        "piAgentAutoRetryCount",
        "piAgentAutoRetriesMaximumInOneCycle",
        "providerSdkRetriesPerCallConfiguredMaximum",
        "maxObservedAggregateStorageBytes",
        "maxObservedAggregateStorageInodes",
        "taskSandboxNetworkMode",
        "hostModelNetworkAuthorization",
        "gitRemoteMode",
        "loopStatus"
      ],
      "properties": {
        "provider": { "const": "openai-codex" },
        "model": { "const": "gpt-5.6-luna" },
        "thinkingLevel": { "const": "max" },
        "attemptOrdinal": { "const": 1 },
        "turnCount": { "const": 1 },
        "hostMonotonicStartMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hostMonotonicEndMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalToolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "gameToolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "piAgentAutoRetryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "piAgentAutoRetriesMaximumInOneCycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "providerSdkRetriesPerCallConfiguredMaximum": { "const": 0 },
        "maxObservedAggregateStorageBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "maxObservedAggregateStorageInodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "taskSandboxNetworkMode": { "const": "denied" },
        "hostModelNetworkAuthorization": { "const": "provider_only" },
        "gitRemoteMode": { "const": "absent" },
        "loopStatus": {
          "enum": ["completed", "provider_failed", "aborted", "timed_out"]
        }
      }
    },
    "evaluatorUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostMonotonicStartMs",
        "hostMonotonicEndMs",
        "maxObservedAggregateStorageBytes",
        "maxObservedAggregateStorageInodes"
      ],
      "properties": {
        "hostMonotonicStartMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hostMonotonicEndMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxObservedAggregateStorageBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "maxObservedAggregateStorageInodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "cleanupReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptKind",
        "assignmentId",
        "evaluationId",
        "scope",
        "attemptOrdinal",
        "taskProcessesEmpty",
        "taskCgroupsEmpty",
        "taskStorageEmpty",
        "sourceUnchanged",
        "receiptContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receiptKind": { "const": "evaluation_cleanup" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "scope": { "enum": ["agent_attempt", "evaluator_attempt"] },
        "attemptOrdinal": { "type": "integer", "minimum": 1, "maximum": 2 },
        "taskProcessesEmpty": { "type": "boolean" },
        "taskCgroupsEmpty": { "type": "boolean" },
        "taskStorageEmpty": { "type": "boolean" },
        "sourceUnchanged": { "type": "boolean" },
        "receiptContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "agentAttemptReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptKind",
        "assignmentContentSha256",
        "assignmentId",
        "evaluationId",
        "contractSha256",
        "taskSpecSha256",
        "promptSha256",
        "baselineSourceSha256",
        "outcome",
        "workspaceSourceSha256",
        "workspacePatch",
        "candidateSourceSha256",
        "candidatePatch",
        "usage",
        "cleanupReceipt",
        "receiptContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receiptKind": { "const": "agent_attempt" },
        "assignmentContentSha256": { "$ref": "#/$defs/sha256" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "taskSpecSha256": { "$ref": "#/$defs/sha256" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "baselineSourceSha256": { "$ref": "#/$defs/sha256" },
        "outcome": {
          "enum": [
            "candidate_produced",
            "provider_failed",
            "aborted",
            "timed_out",
            "no_candidate",
            "budget_exceeded",
            "sandbox_failed",
            "patch_handoff_failed"
          ]
        },
        "workspaceSourceSha256": { "$ref": "#/$defs/sha256" },
        "workspacePatch": { "$ref": "#/$defs/artifactReference" },
        "candidateSourceSha256": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "candidatePatch": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }]
        },
        "usage": { "$ref": "#/$defs/agentUsage" },
        "cleanupReceipt": { "$ref": "#/$defs/artifactReference" },
        "receiptContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "invalidCandidateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptKind",
        "assignmentId",
        "evaluationId",
        "candidateSourceSha256",
        "candidatePatchSha256",
        "evaluatorImplementationSha256",
        "evaluatorBundleSha256",
        "status",
        "reason",
        "receiptContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receiptKind": { "const": "candidate_admission" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "candidateSourceSha256": { "$ref": "#/$defs/sha256" },
        "candidatePatchSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorImplementationSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorBundleSha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "rejected" },
        "reason": { "const": "candidate_admission_rejected" },
        "receiptContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "executionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeTaskId",
        "buildId",
        "runtimeId",
        "executionId",
        "buildRecord",
        "runtimeRecord",
        "executionRecord",
        "eventLedger",
        "executionSeal"
      ],
      "properties": {
        "runtimeTaskId": { "$ref": "#/$defs/opaqueId" },
        "buildId": { "$ref": "#/$defs/opaqueId" },
        "runtimeId": { "$ref": "#/$defs/opaqueId" },
        "executionId": { "$ref": "#/$defs/opaqueId" },
        "buildRecord": { "$ref": "#/$defs/artifactReference" },
        "runtimeRecord": { "$ref": "#/$defs/artifactReference" },
        "executionRecord": { "$ref": "#/$defs/artifactReference" },
        "eventLedger": { "$ref": "#/$defs/artifactReference" },
        "executionSeal": { "$ref": "#/$defs/artifactReference" }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "outcome",
        "failureKind",
        "notRunReason",
        "executionArtifacts",
        "coverage",
        "lossObserved"
      ],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/scenarioId" },
        "outcome": { "enum": ["passed", "failed", "not_run"] },
        "failureKind": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["oracle_mismatch", "candidate_execution_failure"] }
          ]
        },
        "notRunReason": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["fail_fast", "invalid_candidate"] }
          ]
        },
        "executionArtifacts": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/executionArtifact" }
        },
        "coverage": { "enum": ["complete", "degraded", "unavailable"] },
        "lossObserved": { "type": "boolean" }
      }
    },
    "evaluationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "messageKind",
        "assignmentContentSha256",
        "assignmentId",
        "evaluationId",
        "contractSha256",
        "taskSpecSha256",
        "promptSha256",
        "productCommit",
        "baselineSourceSha256",
        "candidateSourceSha256",
        "candidatePatchSha256",
        "evaluatorImplementationSha256",
        "evaluatorBundleSha256",
        "plannedScenarioIds",
        "agentAttemptReceipt",
        "agentAttemptOrdinal",
        "evaluatorAttemptOrdinal",
        "previousResultContentSha256",
        "requestContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageKind": { "const": "evaluation_request" },
        "assignmentContentSha256": { "$ref": "#/$defs/sha256" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "taskSpecSha256": { "$ref": "#/$defs/sha256" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "productCommit": { "$ref": "#/$defs/gitCommit" },
        "baselineSourceSha256": { "$ref": "#/$defs/sha256" },
        "candidateSourceSha256": { "$ref": "#/$defs/sha256" },
        "candidatePatchSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorImplementationSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorBundleSha256": { "$ref": "#/$defs/sha256" },
        "plannedScenarioIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scenarioId" }
        },
        "agentAttemptReceipt": { "$ref": "#/$defs/artifactReference" },
        "agentAttemptOrdinal": { "const": 1 },
        "evaluatorAttemptOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "previousResultContentSha256": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "requestContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluatedResult": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "invalid_candidate" } }
          },
          "then": {
            "properties": {
              "invalidCandidateReason": {
                "const": "candidate_admission_rejected"
              },
              "invalidCandidateReceipt": {
                "$ref": "#/$defs/artifactReference"
              }
            }
          },
          "else": {
            "properties": {
              "invalidCandidateReason": { "type": "null" },
              "invalidCandidateReceipt": { "type": "null" }
            }
          }
        }
      ],
      "required": [
        "schemaVersion",
        "messageKind",
        "assignmentId",
        "evaluationId",
        "contractSha256",
        "taskSpecSha256",
        "promptSha256",
        "candidateSourceSha256",
        "candidatePatchSha256",
        "evaluatorImplementationSha256",
        "evaluatorBundleSha256",
        "evaluatorAttemptOrdinal",
        "requestContentSha256",
        "outcome",
        "invalidCandidateReason",
        "invalidCandidateReceipt",
        "scenarioResults",
        "evaluatorUsage",
        "cleanupReceipt",
        "resultContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageKind": { "const": "evaluation_result" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "taskSpecSha256": { "$ref": "#/$defs/sha256" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "candidateSourceSha256": { "$ref": "#/$defs/sha256" },
        "candidatePatchSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorImplementationSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorBundleSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorAttemptOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "requestContentSha256": { "$ref": "#/$defs/sha256" },
        "outcome": { "enum": ["accepted", "rejected", "invalid_candidate"] },
        "invalidCandidateReason": {
          "oneOf": [
            { "type": "null" },
            {
              "const": "candidate_admission_rejected"
            }
          ]
        },
        "invalidCandidateReceipt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }]
        },
        "scenarioResults": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/scenarioResult" }
        },
        "evaluatorUsage": { "$ref": "#/$defs/evaluatorUsage" },
        "cleanupReceipt": { "$ref": "#/$defs/artifactReference" },
        "resultContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "infrastructureFailureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "messageKind",
        "assignmentId",
        "evaluationId",
        "contractSha256",
        "taskSpecSha256",
        "promptSha256",
        "candidateSourceSha256",
        "candidatePatchSha256",
        "evaluatorImplementationSha256",
        "evaluatorBundleSha256",
        "evaluatorAttemptOrdinal",
        "requestContentSha256",
        "outcome",
        "failureAttribution",
        "stage",
        "failureCode",
        "retryable",
        "completedScenarioResults",
        "remainingScenarioIds",
        "scenarioStartedCount",
        "oracleComparisonCount",
        "executionCount",
        "evaluatorUsage",
        "cleanupReceipt",
        "resultContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageKind": { "const": "evaluation_result" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "taskSpecSha256": { "$ref": "#/$defs/sha256" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "candidateSourceSha256": { "$ref": "#/$defs/sha256" },
        "candidatePatchSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorImplementationSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorBundleSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorAttemptOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "requestContentSha256": { "$ref": "#/$defs/sha256" },
        "outcome": { "const": "infrastructure_failure" },
        "failureAttribution": { "const": "host_or_evaluator_infrastructure" },
        "stage": {
          "enum": [
            "admission",
            "baseline_reproduction",
            "observation",
            "persistence",
            "cleanup",
            "evaluator_internal"
          ]
        },
        "failureCode": {
          "enum": [
            "host_unavailable",
            "toolchain_unavailable",
            "sandbox_unavailable",
            "storage_unavailable",
            "cleanup_failed",
            "evaluator_internal",
            "evaluator_budget_exceeded"
          ]
        },
        "retryable": { "type": "boolean" },
        "completedScenarioResults": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/scenarioResult" }
        },
        "remainingScenarioIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scenarioId" }
        },
        "scenarioStartedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "oracleComparisonCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "executionCount": { "type": "integer", "minimum": 0, "maximum": 128 },
        "evaluatorUsage": { "$ref": "#/$defs/evaluatorUsage" },
        "cleanupReceipt": { "$ref": "#/$defs/artifactReference" },
        "resultContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluatorAttemptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "requestReceipt", "result", "resultReceipt"],
      "properties": {
        "request": { "$ref": "#/$defs/evaluationRequest" },
        "requestReceipt": { "$ref": "#/$defs/artifactReference" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/evaluatedResult" },
            { "$ref": "#/$defs/infrastructureFailureResult" }
          ]
        },
        "resultReceipt": { "$ref": "#/$defs/artifactReference" }
      }
    },
    "evaluationLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "messageKind",
        "assignmentContentSha256",
        "assignmentId",
        "evaluationId",
        "contractSha256",
        "taskSpec",
        "prompt",
        "productCommit",
        "productSubjectReceipt",
        "baselineSourceSha256",
        "agentAttempt",
        "agentAttemptReceipt",
        "evaluatorImplementationSha256",
        "evaluatorBundleSha256",
        "evaluationArtifactsSha256",
        "evaluatorAttempts",
        "finalOutcome",
        "allAttemptsRetained",
        "ledgerContentSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageKind": { "const": "evaluation_ledger" },
        "assignmentContentSha256": { "$ref": "#/$defs/sha256" },
        "assignmentId": { "$ref": "#/$defs/assignmentId" },
        "evaluationId": { "$ref": "#/$defs/evaluationId" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "taskSpec": { "$ref": "#/$defs/artifactReference" },
        "prompt": { "$ref": "#/$defs/artifactReference" },
        "productCommit": { "$ref": "#/$defs/gitCommit" },
        "productSubjectReceipt": { "$ref": "#/$defs/artifactReference" },
        "baselineSourceSha256": { "$ref": "#/$defs/sha256" },
        "agentAttempt": { "$ref": "#/$defs/agentAttemptReceipt" },
        "agentAttemptReceipt": { "$ref": "#/$defs/artifactReference" },
        "evaluatorImplementationSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorBundleSha256": { "$ref": "#/$defs/sha256" },
        "evaluationArtifactsSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorAttempts": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/evaluatorAttemptEntry" }
        },
        "finalOutcome": {
          "enum": [
            "accepted",
            "rejected",
            "invalid_candidate",
            "infrastructure_failure",
            "agent_provider_failed",
            "agent_aborted",
            "agent_timed_out",
            "agent_no_candidate",
            "agent_budget_exceeded",
            "agent_sandbox_failed",
            "agent_patch_handoff_failed"
          ]
        },
        "allAttemptsRetained": { "const": true },
        "ledgerContentSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
