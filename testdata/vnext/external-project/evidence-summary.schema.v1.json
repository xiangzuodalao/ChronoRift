{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronorift.invalid/test-only/m4-external-project-evidence-summary.v1.schema.json",
  "title": "ChronoRift M4 external-project conformance evidence summary V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "conformanceSpecSha256",
    "profile",
    "driver",
    "source",
    "descriptor",
    "toolchain",
    "sandbox",
    "lifecycleTools",
    "taskLifecycle",
    "runtime",
    "candidate",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceKind": {
      "const": "chronorift-m4-external-project-conformance-evidence"
    },
    "conformanceSpecSha256": {
      "const": "1fc43c0eaea45ed9fa129a7a2e06913c0cc37495633dc4d90dd3fd7598de5f82"
    },
    "profile": { "const": "chronorift-godot-lifecycle-v1" },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "providerContacted"],
      "properties": {
        "kind": { "const": "deterministic-fake-pi" },
        "providerContacted": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredSourceUrl",
        "headCommit",
        "gitTreeObjectId",
        "selectedTreeSha256",
        "entryCount",
        "declaredByteLength",
        "cleanBeforeTask",
        "unchangedAfterTask"
      ],
      "properties": {
        "declaredSourceUrl": {
          "const": "https://github.com/endlessm/moddable-platformer"
        },
        "headCommit": {
          "const": "3e793f53598a131c53fb82555191cc14b8db07ff"
        },
        "gitTreeObjectId": {
          "const": "a013bd677c712dbf354e8e2f6e8ff7c53d5684c6"
        },
        "selectedTreeSha256": {
          "const": "3e8bd6478d53586284010da38959005e2a377ef6277b2a838ecb1538abc096e8"
        },
        "entryCount": { "const": 543 },
        "declaredByteLength": { "const": 1380343 },
        "cleanBeforeTask": { "const": true },
        "unchangedAfterTask": { "const": true }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "persistedBytesRevalidated"],
      "properties": {
        "sha256": {
          "const": "534dcd8aa14aeea74685059f8d66e44e5bebe21742b7a702ee7d78e91e1a955e"
        },
        "persistedBytesRevalidated": { "const": true }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "godotVersion"],
      "properties": {
        "nodeVersion": { "const": "v22.23.1" },
        "godotVersion": {
          "const": "4.7.1.stable.official.a13da4feb"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkMode",
        "storageFilesystem",
        "storageCapacityBytes",
        "storageInodeCapacity",
        "delegatedControllers",
        "sourceMountedReadOnly",
        "taskCredentialMountCount",
        "mountAdmissionReceiptCount",
        "mountAdmissionsSha256",
        "taskSharedWritableTargets"
      ],
      "properties": {
        "networkMode": { "const": "loopback_only" },
        "storageFilesystem": { "const": "tmpfs" },
        "storageCapacityBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "storageInodeCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "delegatedControllers": { "const": ["cpu", "memory", "pids"] },
        "sourceMountedReadOnly": { "const": true },
        "taskCredentialMountCount": { "const": 0 },
        "mountAdmissionReceiptCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "mountAdmissionsSha256": { "$ref": "#/$defs/sha256" },
        "taskSharedWritableTargets": { "const": ["/tmp", "/artifacts"] }
      }
    },
    "lifecycleTools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposed", "notExposed"],
      "properties": {
        "exposed": {
          "const": [
            "game_capabilities",
            "game_launch",
            "game_status",
            "game_stop"
          ]
        },
        "notExposed": {
          "const": [
            "game_capture_configure",
            "game_capture_pin",
            "game_query",
            "game_input",
            "game_step",
            "game_set_controls",
            "game_checkpoint_create",
            "game_checkpoint_restore",
            "game_fork",
            "game_trace_create",
            "game_trace_replay",
            "game_compare"
          ]
        }
      }
    },
    "taskLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycleOperationsObserved", "profilePreservedOnContinue"],
      "properties": {
        "lifecycleOperationsObserved": {
          "const": ["start", "continue", "show", "export", "discard"]
        },
        "profilePreservedOnContinue": { "const": true }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import", "vanilla", "overlay", "shutdown"],
      "properties": {
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exitCode",
            "timedOut",
            "durationMs",
            "timingFidelity",
            "stdout",
            "stderr",
            "receiptSha256"
          ],
          "properties": {
            "exitCode": { "const": 0 },
            "timedOut": { "const": false },
            "durationMs": { "type": "integer", "minimum": 0 },
            "timingFidelity": { "const": "operation_bounds" },
            "stdout": { "$ref": "#/$defs/diagnosticStream" },
            "stderr": { "$ref": "#/$defs/diagnosticStream" },
            "receiptSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "vanilla": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stabilityObservedMs",
            "timingFidelity",
            "timedOut",
            "stoppedByHarness",
            "stdout",
            "stderr",
            "receiptSha256"
          ],
          "properties": {
            "stabilityObservedMs": { "type": "integer", "minimum": 2000 },
            "timingFidelity": { "const": "operation_bounds" },
            "timedOut": { "const": false },
            "stoppedByHarness": { "const": true },
            "stdout": { "$ref": "#/$defs/diagnosticStream" },
            "stderr": { "$ref": "#/$defs/diagnosticStream" },
            "receiptSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocolVersion",
            "handshakeObserved",
            "addonSha256",
            "candidateSourceSha256",
            "engineVersion",
            "platform",
            "renderer",
            "configuredSceneMatched",
            "currentSceneMatched",
            "processFrameDelta",
            "physicsTickDelta",
            "hostMonotonicStartUs",
            "hostMonotonicEndUs",
            "diagnosticLossObserved",
            "receiptSha256"
          ],
          "properties": {
            "protocolVersion": { "const": 1 },
            "handshakeObserved": { "const": true },
            "addonSha256": { "$ref": "#/$defs/sha256" },
            "candidateSourceSha256": {
              "const": "8aa71e3ea1839fb4a56940b25a3b61bc747bf712ec7a7221cdb42ecaaeeb2336"
            },
            "engineVersion": {
              "const": "4.7.1-stable (official)"
            },
            "platform": { "const": "Linux" },
            "renderer": { "const": "gl_compatibility" },
            "configuredSceneMatched": { "const": true },
            "currentSceneMatched": { "const": true },
            "processFrameDelta": { "type": "integer", "minimum": 120 },
            "physicsTickDelta": { "type": "integer", "minimum": 120 },
            "hostMonotonicStartUs": { "type": "integer", "minimum": 0 },
            "hostMonotonicEndUs": { "type": "integer", "minimum": 0 },
            "diagnosticLossObserved": { "const": false },
            "receiptSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "shutdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finalStatus", "receiptSha256"],
          "properties": {
            "finalStatus": { "const": "stopped" },
            "receiptSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "mode",
        "contentSha256",
        "baselineSelectedTreeSha256",
        "candidateSelectedTreeSha256",
        "exportedPatchSha256",
        "roundTripSelectedTreeSha256"
      ],
      "properties": {
        "relativePath": { "const": "CHRONORIFT_ONBOARDING_SMOKE.md" },
        "mode": { "const": "100644" },
        "contentSha256": {
          "const": "04b0627d60c82e79178aaf7d8b9c7a7591a6bef635be21226e6cae6235b4089e"
        },
        "baselineSelectedTreeSha256": {
          "const": "3e8bd6478d53586284010da38959005e2a377ef6277b2a838ecb1538abc096e8"
        },
        "candidateSelectedTreeSha256": {
          "const": "8aa71e3ea1839fb4a56940b25a3b61bc747bf712ec7a7221cdb42ecaaeeb2336"
        },
        "exportedPatchSha256": { "$ref": "#/$defs/sha256" },
        "roundTripSelectedTreeSha256": {
          "const": "8aa71e3ea1839fb4a56940b25a3b61bc747bf712ec7a7221cdb42ecaaeeb2336"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskDiscarded",
        "taskProcessesEmpty",
        "taskCgroupsEmpty",
        "taskStorageEmpty"
      ],
      "properties": {
        "taskDiscarded": { "const": true },
        "taskProcessesEmpty": { "const": true },
        "taskCgroupsEmpty": { "const": true },
        "taskStorageEmpty": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "diagnosticStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalSha256", "totalBytes", "retainedBytes", "truncated"],
      "properties": {
        "totalSha256": { "$ref": "#/$defs/sha256" },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "retainedBytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
